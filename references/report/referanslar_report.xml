<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="referanslar_report_document">
        <t t-call="web.html_container">
            <style>
                @font-face {
                    font-family: 'PF BeauSans Pro';
                    src: url('https://erp.elva.com.tr/wp-content/uploads/useanyfont/190927113233BeauSans-Reg.woff') format('woff');
                    font-weight: normal;
                    font-style: normal;
                }

                @font-face {
                    font-family: 'PF BeauSans Pro Bold';
                    src: url('https://erp.elva.com.tr/wp-content/uploads/useanyfont/190927112959BeauSans-Bold.woff') format('woff');
                    font-weight: bold;
                    font-style: normal;
                }

                body, div, table, th, td, p, h1, h2, h3, span {
                    font-family: 'PF BeauSans Pro' !important;
                }
                table.referans-table {
                    border-spacing: 0 !important;
                    border-collapse: collapse !important;
                }
                .referans-table, .referans-table th, .referans-table td {
                    padding: 6px !important;
                    border: 1px solid #000 !important;
                }
                table.referans-header, .referans-header td {
                    border: none !important;
                    padding: 0 !important;
                }
            </style>
            <meta charset="UTF-8"/>
            <t t-set="company" t-value="docs and docs[0].company_id.sudo() or res_company"/>

            <div class="page">
                <div style="margin-top:0px !important;padding:0 30px 10px 70px !important;">
                    <table class="referans-header" style="width:100%;">
                        <tr>
                            <td style="width:64%;vertical-align:middle;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 160px; max-width: 420px;" alt="Logo"/>
                            </td>
                            <td style="width:36%;vertical-align:middle;">
                                <span t-field="company.name"/><br/>
                                <span t-field="company.street"/><br/>
                                <span t-if="company.street2" t-field="company.street2"/><br t-if="company.street2"/>
                                <span t-field="company.zip"/> <span t-field="company.city"/> / <span t-field="company.state_id.name"/><br/>
                                <span t-raw="(company.country_id.name or '').upper().replace('I','İ')"/><br/>
                                <span t-field="company.email"/><br/>
                                <span t-raw="(company.website or '').replace('https://','').replace('http://','')"/>
                            </td>
                        </tr>
                    </table>

                    <div style="float:left;width:100%;clear:both !important;margin-top:15px;font-weight:bold;font-size:14.4pt !important;font-family:'PF BeauSans Pro Bold' !important;">
                        Referanslar
                    </div>

                    <div style="float:left;width:100%;clear:both !important;margin-top:15px;">
                        <table class="referans-table" style="width:100%;font-size:9pt !important;">
                            <thead>
                                <tr style="background:#f6f6f6;">
                                    <th class="text-center" width="4%">No</th>
                                    <th class="text-left" width="25%">Fırsat</th>
                                    <th class="text-left" width="20%">Bayi Adı</th>
                                    <th class="text-left" width="15%">Sistem Çözümü</th>
                                    <th class="text-left" width="12%">Sektör</th>
                                    <th class="text-center" width="6%">Yıl</th>
                                    <th class="text-right" width="10%">Gelir</th>
                                    <th class="text-left" width="8%">Aşama</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sira_no" t-value="1"/>
                                <t t-foreach="docs" t-as="o">
                                    <tr>
                                        <td style="text-align:center;" valign="top"><t t-esc="sira_no"/></td>
                                        <td style="text-align:left;" valign="top"><t t-esc="o.name"/></td>
                                        <td style="text-align:left;" valign="top"><t t-esc="o.partner_id.name"/></td>
                                        <td style="text-align:left;" valign="top"><t t-esc="', '.join(o.tag_ids.mapped('name'))"/></td>
                                        <td style="text-align:left;" valign="top"><t t-esc="o.sektor_id.name"/></td>
                                        <td style="text-align:center;" valign="top"><t t-esc="o.referans_yil"/></td>
                                        <td style="text-align:right;" valign="top"><span t-esc="o.expected_revenue" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                        <td style="text-align:left;" valign="top"><t t-esc="o.stage_id.name"/></td>
                                    </tr>
                                    <t t-set="sira_no" t-value="sira_no + 1"/>
                                </t>
                                <tr>
                                    <td colspan="6" style="text-align:right !important;padding:10px !important;font-size:11pt !important;">
                                        <strong>Toplam (<t t-esc="company.currency_id.name"/>)</strong>
                                    </td>
                                    <td style="text-align:right !important;padding:10px !important;font-size:11pt !important;">
                                        <strong><span t-esc="sum(docs.mapped('expected_revenue'))" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></strong>
                                    </td>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div t-attf-class="footer o_standard_footer">
                <div class="text-center" style="line-height:16px;">
                    <div t-if="report_type == 'pdf'" class="text-muted" style="color:#000 !important;">
                        Sayfa: <span class="page"/> / <span class="topage"/>
                    </div>
                    <span t-field="company.name" style="font-weight:bold !important;"/>
                </div>
            </div>
        </t>
    </template>

    <record id="paperformat_referanslar" model="report.paperformat">
        <field name="name">Referanslar A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_referanslar_report" model="ir.actions.report">
        <field name="name">Referanslar</field>
        <field name="model">crm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">references.referanslar_report_document</field>
        <field name="report_file">references.referanslar_report_document</field>
        <field name="print_report_name">'Referanslar'</field>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_referanslar"/>
    </record>

</odoo>
