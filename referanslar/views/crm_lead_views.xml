<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sektör alanını fırsat formuna ekle -->
    <record id="view_crm_lead_form_inherit_referans" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.referans</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']/ancestor::group[1]/field[@name='tag_ids']" position="after">
                <field name="sektor_id" options="{'no_create_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Referanslar liste görünümü -->
    <record id="view_crm_lead_referans_list" model="ir.ui.view">
        <field name="name">crm.lead.referans.list</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <tree string="Referanslar">
                <field name="name" string="Fırsat"/>
                <field name="x_studio_tedarikci" string="Bayi Adı"
                       widget="many2many_tags" optional="show"/>
                <field name="tag_ids" string="Sistem Çözümü"
                       widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="sektor_id" string="Sektör" optional="show"/>
                <field name="referans_yil" string="Yıl" optional="show"/>
                <field name="company_currency" invisible="1"/>
                <field name="expected_revenue" string="Gelir"
                       widget="monetary" sum="Toplam" optional="show"/>
                <field name="stage_id" string="Aşama" optional="show"/>
                <field name="date_deadline" invisible="1"/>
                <field name="type" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Referanslar arama görünümü -->
    <record id="view_crm_lead_referans_search" model="ir.ui.view">
        <field name="name">crm.lead.referans.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search string="Referans Ara">
                <field name="name" string="Fırsat"/>
                <field name="x_studio_tedarikci" string="Bayi Adı"/>
                <field name="tag_ids" string="Sistem Çözümü"/>
                <field name="sektor_id" string="Sektör"/>
                <field name="stage_id" string="Aşama"/>
                <filter name="filter_won" string="Kazanılan"
                        domain="[('stage_id.is_won', '=', True)]"/>
                <separator/>
                <filter name="group_by_sektor" string="Sektör"
                        context="{'group_by': 'sektor_id'}"/>
                <filter name="group_by_yil" string="Yıl"
                        context="{'group_by': 'referans_yil'}"/>
                <filter name="group_by_stage" string="Aşama"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="group_by_bayi" string="Bayi Adı"
                        context="{'group_by': 'x_studio_tedarikci'}"/>
            </search>
        </field>
    </record>

    <record id="action_referanslar" model="ir.actions.act_window">
        <field name="name">Referanslar</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
        <field name="search_view_id" ref="view_crm_lead_referans_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_crm_lead_referans_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('crm.crm_lead_view_form')})]"/>
    </record>
</odoo>
