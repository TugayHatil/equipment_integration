<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_referans_sektor_list" model="ir.ui.view">
        <field name="name">referans.sektor.list</field>
        <field name="model">referans.sektor</field>
        <field name="arch" type="xml">
            <list string="Sektörler" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_referans_sektor_form" model="ir.ui.view">
        <field name="name">referans.sektor.form</field>
        <field name="model">referans.sektor</field>
        <field name="arch" type="xml">
            <form string="Sektör">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_referans_sektor" model="ir.actions.act_window">
        <field name="name">Sektörler</field>
        <field name="res_model">referans.sektor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
